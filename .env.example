# =============================================================================
# DATAFORGE ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and provide your credentials.
# NEVER commit real API keys, secrets, or tokens to version control.
# =============================================================================

# LiveKit WebRTC Cloud / Server Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_ROOM_NAME=default-room

# Deepgram Speech-to-Text (STT) API Key
# Model: nova-2-general
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API Key (Primary & Secondary LLM Fallback)
# Models: gemini-3.5-flash-lite (Primary), gemini-3.1-flash-lite (Tier 2 Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Tertiary Provider Fallback)
# Model: openai/gpt-oss-20b (Tier 3 Fallback)
GROQ_API_KEY=your_groq_api_key_here

# Rime Cloud Text-to-Speech (TTS) API Key
# Model: coda | Speaker: celeste | Language: eng | Sample Rate: 16000Hz | Transport: WebSocket
RIME_API_KEY=your_rime_api_key_here

# Server & Logging Configuration (Optional)
PORT=3000
LOG_LEVEL=info
