# Server-Side Environment Variables (Required for Production / Deployment)
# NOTE: All variables below are server-side only. Real secrets must NEVER be committed to Git.
# The browser/client connects via short-lived tokens and does NOT need these API keys directly.

# LiveKit Cloud WebSocket Endpoint & Credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_NAME=default-room

# Speech-to-Text (Deepgram Nova-2)
DEEPGRAM_API_KEY=

# LLM Reasoning & Tool Calling (Google Gemini)
GEMINI_API_KEY=

# Text-to-Speech (Rime Coda via direct WebSocket)
RIME_API_KEY=

# HTTP Token Server & Static File Server Port
PORT=3000

# Agent Logger Level (info, debug, warn, error)
LOG_LEVEL=info

